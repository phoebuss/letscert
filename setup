#!/usr/bin/env python3

import requests as rq
import os
import time
import re
import subprocess

DEFAULT_LETSCERT_SERVER = "auth.acme-dns.io"
RETRY = 10

INITED_STAMP_FILE = "/data/.inited"

AUTH_HOOK_TEMPLATE = "/app/auth_hook.tmpl"
AUTH_HOOK_FILE = "/data/auth_hook.py"

CERTBOT_CONFIG_DIR = "/cert"
CERTBOT_WORK_DIR = "/data/certbot-work"
CERTBOT_LOGS_DIR = "/data/certbot-logs"
CONFIGURED_DOMAINS_FILE = "/data/configured_domains.txt"

def get_configured_domains() -> list[str]:
    """Get list of already configured domains."""
    if not os.path.exists(CONFIGURED_DOMAINS_FILE):
        return []
    with open(CONFIGURED_DOMAINS_FILE, "r") as f:
        return [line.strip() for line in f if line.strip()]

def add_configured_domain(domain: str):
    """Add domain to configured domains list."""
    with open(CONFIGURED_DOMAINS_FILE, "a") as f:
        f.write(f"{domain}\n")

def get_auth_hook_path(domain: str) -> str:
    """Get unique auth hook path for domain."""
    domain_hash = domain.replace(".", "_").replace("-", "_")
    return f"/data/auth_hook_{domain_hash}.py"

def get_confirm(prompt):
    while True:
        s = input(f"{prompt} (y/n): ").lower().strip()
        if s in ('y', 'yes'):
            return True
        if s in ('n', 'no'):
            return False
        print("Please enter 'y' or 'n'.")

def dns_query(name: str, record_type: str) -> list[str]:
    url = "https://dns.google/resolve"
    params = {
        "name": name,
        "type": record_type,
        }
    with rq.get(url, params = params) as r:
        if not r.ok:
            raise Exception(f"failed on HTTP GET ({r.reason}): {r.url}")
        data = r.json()

    _ans = data.get("Answer")
    if not _ans:
        return []

    _type = data["Question"][0]["type"]

    return [a["data"].strip('"').rstrip('.') for a in _ans if a["type"] == _type]

def get_domain() -> str:
    domain = os.getenv("LETSCERT_DOMAIN")
    if not domain:
        print("INFO: env LETSCERT_DOMAIN is not defined.")
        domain = input(f"Please enter the domain name: ")
    return domain.lower().strip()

def get_server() -> str:
    server = os.getenv("LETSCERT_SERVER")
    if not server:
        print("INFO: env LETSCERT_SERVER is not defined, using the default one.")
        server = DEFAULT_LETSCERT_SERVER
    return server.lower().strip()

def check_cname_update_status(name: str, target: str):
    for i in range(RETRY):
        print(f"Trying DNS query (retry: {i}), expect: CNAME {name} => {target}")
        r = dns_query(name, "CNAME")
        if target in r:
            return
        time.sleep(10)
    raise Exception(f"Failed on DNS query!!!")

def get_account(domain: str, server: str) -> tuple[str, str, str]:
    username = os.getenv("LETSCERT_USERNAME")
    password = os.getenv("LETSCERT_PASSWORD")
    subdomain = os.getenv("LETSCERT_SUBDOMAIN")
    if not (username and password and subdomain):
        print("INFO: creating account on the ACME DNS server ...")
        url = f"https://{server}/register"
        with rq.post(url) as r:
            if not r.ok:
                raise Exception(f"failed on HTTP POST ({r.reason}): {r.url}")
            data = r.json()

            username = data.get("username")
            password = data.get("password")
            subdomain = data.get("subdomain")
            if not (username and password and subdomain):
                raise Exception(f"malformat response from the ACME DNS server:\n{r.text}")

    name = f"_acme-challenge.{domain}"
    target = f"{subdomain}.{server}"
    print(f"""
INFO: please add a record on your DNS server:

  type: CNAME
  name: {name}
target: {target}

""");
    if not get_confirm("Please confirm if the DNS record is added."):
        raise Exception("Abort!!!")

    check_cname_update_status(name, target)
    return username, password, subdomain

def generate_auth_hook(server: str, username: str, password: str, subdomain: str, domain: str) -> str:
    auth_hook_path = get_auth_hook_path(domain)

    matching = {
        "%%SERVER%%": server,
        "%%USERNAME%%": username,
        "%%PASSWORD%%": password,
        "%%SUBDOMAIN%%": subdomain,
    }
    pattern = re.compile("|".join(re.escape(k) for k in matching))

    with open(AUTH_HOOK_TEMPLATE, "r") as tmpl, open(auth_hook_path, "w") as f:
        for l in tmpl:
            f.write(pattern.sub(lambda m: matching.get(m.group(0), m.group(0)), l))

    os.chmod(auth_hook_path, 0o755)
    return auth_hook_path

def obtain_cert(domain: str, auth_hook_path: str, dryrun: bool=False):
    cmd = ["certbot", "certonly",
           "--config-dir", CERTBOT_CONFIG_DIR,
           "--work-dir", CERTBOT_WORK_DIR,
           "--logs-dir", CERTBOT_LOGS_DIR,
           "--cert-name", domain,
           "-d", domain, "-d", f"*.{domain}",
           "--manual", "--manual-auth-hook", auth_hook_path, "--reuse-key",
           "--preferred-challenges", "dns", "--register-unsafely-without-email",
           "--non-interactive", "--agree-tos", "--no-eff-email"]
    if dryrun:
        cmd += ["--dry-run"]

    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        print(f"Command: {' '.join(map(str, cmd))}\n failed with return code {e.returncode}")

def setup():
    domain = get_domain()
    print(f"INFO: requesting certificate for domain: [{domain}]")

    existing_domains = get_configured_domains()
    if existing_domains:
        print(f"INFO: existing configured domains: {', '.join(existing_domains)}")

    if domain in existing_domains:
        print(f"INFO: domain [{domain}] is already configured, skipping.")
        return

    server = get_server()
    print(f"INFO: using the ACME DNS server: [{server}]")

    username, password, subdomain = get_account(domain, server)
    auth_hook_path = generate_auth_hook(server, username, password, subdomain, domain)
    try:
        obtain_cert(domain, auth_hook_path)
        add_configured_domain(domain)
        print(f"INFO: certificate for domain [{domain}] obtained successfully.")

        if not os.path.exists(INITED_STAMP_FILE):
            with open(INITED_STAMP_FILE, "a"):
                pass
    except Exception as e:
        if os.path.exists(auth_hook_path):
            os.remove(auth_hook_path)
        raise e

def main():
    print("Let's Encrypt certificate renewal setup...")
    try:
        setup()
    except Exception as e:
        print(f"ERROR: {e}")

if __name__ == "__main__":
    main()
